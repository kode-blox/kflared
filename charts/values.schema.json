{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "kubernetesComponent",
    "controllerClass",
    "namespace",
    "serviceAccount",
    "rbac",
    "externalSecrets",
    "clusterCloudflareProvider",
    "leaderElection",
    "metrics",
    "serviceMonitor"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Values shared by a parent chart when KFlared is used as a dependency.",
      "additionalProperties": true
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string"}
      }
    },
    "kubernetesComponent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Descriptive app.kubernetes.io/component label; it is not used in workload selectors."
    },
    "controllerClass": {
      "type": "string",
      "minLength": 1,
      "default": "kflared",
      "description": "Controller ownership class. Must match spec.controller on managed resources."
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "labels", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automount", "annotations", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "automount": {"type": "boolean", "enum": [true]},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}},
        "name": {"type": "string"}
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "helperRoles"],
      "properties": {
        "create": {"type": "boolean"},
        "helperRoles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean"}
          }
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "secretStore", "refreshInterval", "targetSecretName", "secrets"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secretStore": {"type": "string"},
        "refreshInterval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "targetSecretName": {"type": "string", "minLength": 1},
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretKey", "remoteRef"],
            "properties": {
              "secretKey": {"type": "string", "minLength": 1},
              "remoteRef": {
                "type": "object",
                "required": ["key"],
                "properties": {
                  "key": {"type": "string", "minLength": 1}
                },
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "clusterCloudflareProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "name", "accountID", "apiTokenSecretRef", "allowedDNSZones", "bindingNamespaceSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "name": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63,
          "description": "Cluster-scoped provider name. Empty defaults to the chart fullname."
        },
        "accountID": {"type": "string", "maxLength": 32},
        "apiTokenSecretRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": {"type": "string"},
            "key": {"type": "string", "minLength": 1, "default": "api-token"}
          }
        },
        "allowedDNSZones": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "bindingNamespaceSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            "matchExpressions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "operator"],
                "properties": {
                  "key": {"type": "string"},
                  "operator": {"type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
                  "values": {
                    "type": "array",
                    "items": {"type": "string"}
                  }
                }
              }
            }
          },
          "description": "Namespace label selector. An empty object intentionally permits every namespace."
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "secure", "port", "service"],
      "properties": {
        "enabled": {"type": "boolean"},
        "secure": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["annotations"],
          "properties": {
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "labels", "interval", "scrapeTimeout"],
      "properties": {
        "enabled": {"type": "boolean"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}},
        "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"},
        "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m|h)$"}
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "podSecurityContext": {"type": "object"},
    "securityContext": {"type": "object"},
    "resources": {"type": "object"},
    "livenessProbe": {"type": "object"},
    "readinessProbe": {"type": "object"},
    "extraArgs": {"type": "array", "items": {"type": "string"}},
    "extraEnv": {"type": "array"},
    "volumes": {"type": "array"},
    "volumeMounts": {"type": "array"},
    "priorityClassName": {"type": "string"},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "enabled": {"const": true}
            },
            "required": ["enabled"]
          }
        },
        "required": ["externalSecrets"]
      },
      "then": {
        "properties": {
          "externalSecrets": {
            "properties": {
              "secretStore": {"minLength": 1},
              "secrets": {"minItems": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "clusterCloudflareProvider": {
            "properties": {
              "enabled": {"const": true}
            },
            "required": ["enabled"]
          }
        },
        "required": ["clusterCloudflareProvider"]
      },
      "then": {
        "properties": {
          "clusterCloudflareProvider": {
            "properties": {
              "accountID": {"minLength": 1}
            }
          }
        }
      }
    }
  ]
}
